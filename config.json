{
  "photoDirectory": "/Users/mini/all-pics",
  "databasePath": "./data/pictureframe.db",
  "debug": {
    "enabled": true
  },
  "serverPort": 3000,
  "slideshow": {
    "defaultInterval": 10,
    "defaultMode": "sequential",
    "defaultOrder": "date",
    "numberOfImagesToPreload": 15
  },
  "fileExtensions": [
    ".jpg",
    ".jpeg",
    ".png",
    ".gif",
    ".webp",
    ".heic",
    ".heif"
  ],
  "indexing": {
    "batchSize": 100,
    "logInterval": 500
  },
  "watcher": {
    "usePolling": false
  },
  "resize": {
    "maxWidth": 3840,
    "maxHeight": 2160,
    "runOnStartup": true
  },
  "artisticScore": {
    "enabled": false,
    "apiKey": null,
    "model": "claude-sonnet-4-20250514",
    "batchSize": 50,
    "rateLimitMs": 1000,
    "maxImageSize": 1024,
    "runOnStartup": true
  }
}
